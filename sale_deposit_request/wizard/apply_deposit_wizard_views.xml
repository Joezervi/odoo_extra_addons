<odoo>

    <record id="view_apply_deposit_wizard_form" model="ir.ui.view">
        <field name="name">apply.deposit.wizard.form</field>
        <field name="model">sale.deposit.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Deposit">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="deposit_request_id"/>
                    <field name="available_amount" readonly="1"/>
                    <field name="apply_amount"/>
                </group>

                <footer>
                    <button name="action_apply" type="object" string="Apply Deposit" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>