<odoo>

    <record id="view_deposit_invoice_wizard_form" model="ir.ui.view">
        <field name="name">deposit.invoice.wizard.form</field>
        <field name="model">sale.deposit.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Deposit Invoice">
                <group>
                    <field name="deposit_request_id" readonly="1"/>
                    <field name="available_amount" readonly="1"/>
                    <field name="invoice_amount"/>
                    <field name="invoice_date"/>
                </group>

                <footer>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>