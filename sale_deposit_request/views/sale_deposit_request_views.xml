<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sale_deposit_request_tree" model="ir.ui.view">
        <field name="name">sale.deposit.request.list</field>
        <field name="model">sale.deposit.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="deposit_type"/>
                <field name="deposit_amount"/>
                <!-- <field name="payment_amount"/> -->
                <field name="balance_amount"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_sale_deposit_request_form" model="ir.ui.view">
        <field name="name">sale.deposit.request.form</field>
        <field name="model">sale.deposit.request</field>
        <field name="arch" type="xml">
            <form string="Sales Deposit Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_sales_approve" string="Sales Approve" type="object" groups="sale_deposit_request.group_deposit_sales_manager" invisible="state != 'submitted'" />
                    <button name="action_finance_approve" string="Finance Approve" type="object" groups="sale_deposit_request.group_deposit_finance_manager" invisible="state != 'sales_approved'" />
                    <button name="action_create_invoice" string="Create Deposit Invoice" type="object" class="btn-primary" invisible="state != 'finance_approved'" />
                    <!-- <button name="action_open_invoice_wizard" string="Create Deposit Invoice" type="object" class="btn-primary" invisible=" state != 'finance_approved'"/> -->
                    <button name="action_cancel" string="Cancel" type="object" />
                    <field name="state" widget="statusbar" statusbar_visible="
                           draft,
                           submitted,
                           sales_approved,
                           finance_approved,
                           invoiced,
                           paid,
                           applied"/>
                </header>
                <sheet>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="deposit_type"/>
                            <field name="deposit_percent" invisible="deposit_type != 'percent'"/>
                            <field name="deposit_amount"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                            <!-- <field name="payment_amount" readonly="1"/> -->
                        </group>
                        <group>
                            <field name="balance_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>

                        <!-- SO Lines -->
                        <page string="Sales Orders">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sale_order_id"/>
                                    <field name="sale_order_line_id"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="amount"/>
                                    <field name="deposit_amount"/>
                                </list>
                            </field>
                        </page>

                        <!-- Invoices -->
                        <page string="Invoices">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- Approval -->
                        <page string="Approvals">
                            <group>
                                <group>
                                    <field name="submitted_by" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="sales_approved_by" readonly="1"/>
                                    <field name="sales_approved_date" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="finance_approved_by" readonly="1"/>
                                    <field name="finance_approved_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <!-- Notes -->
                        <page string="Internal Notes">

                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sale_deposit_request_search" model="ir.ui.view">
        <field name="name">sale.deposit.request.search</field>
        <field name="model">sale.deposit.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','finance_approved')]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <group>
                    <!-- <filter string="Customer" context="{'group_by':'partner_id'}"/> -->
                    <!-- <filter string="Reference" name="group_by_object_id" domain="[]" context="{'group_by': 'object_id'}" /> -->
                    <!-- <filter string="Status" context="{'group_by':'state'}"/> -->
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_deposit_request" model="ir.actions.act_window">
        <field name="name">Deposit Requests</field>
        <field name="res_model">sale.deposit.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
