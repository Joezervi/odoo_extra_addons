<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- NOTES POPUP FORM (no t-if, Odoo 19 safe)    -->
    <!-- ============================================ -->

    <record id="view_mrp_production_notes_form" model="ir.ui.view">
        <field name="name">mrp.production.notes.form</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <form string="Job Notes">
                <sheet>
                    <group string="Quick Notes">
                        <field name="name" readonly="1" string="MO Reference"/>
                        <field name="x_product_short_name" readonly="1" string="Product"/>
                        <field name="x_notes" nolabel="1"
                               widget="text"
                               placeholder="e.g. 'Waiting for customer approval', 'Missing cyan ink'..."
                               style="min-height: 150px;"/>
                        <field name="x_notes_updated" readonly="1" string="Last Updated"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save &amp; Close" special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- STAGE LOG VIEWS                              -->
    <!-- ============================================ -->

    <record id="view_mrp_stage_log_tree" model="ir.ui.view">
        <field name="name">mrp.production.stage.log.tree</field>
        <field name="model">mrp.production.stage.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="from_stage"/>
                <field name="to_stage"/>
                <field name="duration_hours" widget="float_time"/>
                <field name="user_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_stage_log_form" model="ir.ui.view">
        <field name="name">mrp.production.stage.log.form</field>
        <field name="model">mrp.production.stage.log</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="production_id"/>
                    <field name="from_stage"/>
                    <field name="to_stage"/>
                    <field name="duration_hours" widget="float_time"/>
                    <field name="user_id"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_mrp_stage_log" model="ir.actions.act_window">
        <field name="name">Stage Transition Log</field>
        <field name="res_model">mrp.production.stage.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_all_stage_logs" model="ir.actions.act_window">
        <field name="name">All Stage Transitions</field>
        <field name="res_model">mrp.production.stage.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================ -->
    <!-- KANBAN VIEW v6.0 - Full Cups by AA Revamp    -->
    <!-- ============================================ -->

    <record id="view_mrp_production_kanban_enhanced" model="ir.ui.view">
        <field name="name">mrp.production.kanban.enhanced</field>
        <field name="model">mrp.production</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_simple_stage"
                    limit="80"
                    group_create="false"
                    group_delete="false"
                    quick_create="false"
                    records_draggable="1"
                    class="o_bhd_mo_kanban">

                <!-- Field declarations -->
                <field name="x_simple_stage"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="x_partner_id"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <field name="state"/>
                <field name="assigned_to"/>
                <field name="date_deadline"/>
                <field name="origin"/>
                <field name="x_product_short_name"/>
                <field name="x_deadline_status"/>
                <field name="x_deadline_days"/>
                <field name="x_stage_index"/>
                <field name="x_product_image"/>
                <field name="x_has_design_image"/>
                <field name="x_sale_line_description"/>
                <field name="x_invoice_image_count"/>
                <field name="x_invoice_photos_html"/>
                <field name="x_notes"/>
                <field name="x_notes_updated"/>
                <field name="x_kanban_status"/>
                <field name="x_delivery_ref"/>
                <field name="x_delivery_state"/>
                <field name="incoming_picking"/>
                <field name="x_product_categ_id"/>
                <field name="is_cupsbyaa"/>
                <field name="cupsbyaa_order_id"/>
                <field name="cupsbyaa_phone"/>
                <field name="cupsbyaa_cup_size"/>
                <field name="cupsbyaa_design_url"/>
                <field name="cupsbyaa_turnaround"/>
                <field name="cupsbyaa_partner_id"/>
                <field name="x_partner_phone"/>
                <field name="x_design_image"/>
                <field name="sale_line_id"/>
                <field name="x_sale_line_design_image"/>

                <!-- Feature 3: Search Panel for Quick Filters -->
                <searchpanel>
                    <field name="x_kanban_status" string="Status" select="one"/>
                    <field name="x_product_categ_id" string="Category" select="multi"/>
                    <field name="x_partner_id" string="Customer" select="multi"/>
                </searchpanel>

                <progressbar field="x_deadline_status"
                    colors='{"ok": "success", "today": "warning", "warning": "warning", "danger": "danger", "none": "muted"}'/>

                <templates>
                    <t t-name="card">

                        <!-- Hero image + blocked/waiting overlay -->
                        <div t-attf-class="o_bhd_hero #{record.is_cupsbyaa.raw_value ? 'o_bhd_hero_cupsbyaa' : ''} #{record.x_kanban_status.raw_value === 'blocked' ? 'o_bhd_hero_blocked' : record.x_kanban_status.raw_value === 'waiting' ? 'o_bhd_hero_waiting' : ''}">

                            <!-- Design image: MO's own x_design_image first -->
                            <img t-if="record.x_design_image.raw_value"
                                 t-attf-src="/web/image/mrp.production/#{record.id.raw_value}/x_design_image"
                                 class="o_bhd_hero_img" alt="Design"/>
                            <!-- Fallback: sale order line design image -->
                            <img t-elif="record.sale_line_id.raw_value &amp;&amp; record.x_has_design_image.raw_value"
                                 t-attf-src="/web/image/sale.order.line/#{record.sale_line_id.raw_value}/x_design_image"
                                 class="o_bhd_hero_img" alt="Design"/>
                            <!-- Fallback: product image -->
                            <img t-elif="record.x_product_image.raw_value"
                                 t-attf-src="/web/image/product.product/#{record.product_id.raw_value}/image_512"
                                 class="o_bhd_hero_img" alt="Product"/>
                            <!-- Fallback: colored placeholder -->
                            <div t-if="!record.x_design_image.raw_value &amp;&amp; !(record.sale_line_id.raw_value &amp;&amp; record.x_has_design_image.raw_value) &amp;&amp; !record.x_product_image.raw_value"
                                 t-attf-class="o_bhd_hero_placeholder o_bhd_stage_bg_#{record.x_simple_stage.raw_value}">
                                <t t-out="record.x_product_short_name.raw_value ? record.x_product_short_name.raw_value[0].toUpperCase() : '?'"/>
                            </div>

                            <!-- Overdue / Today deadline badges -->
                            <span t-if="record.is_overdue.raw_value" class="o_bhd_overdue_badge">OVERDUE</span>
                            <span t-elif="record.x_deadline_status.raw_value === 'today'" class="o_bhd_today_badge">DUE TODAY</span>

                            <!-- Blocked/Waiting status indicator -->
                            <span t-if="record.x_kanban_status.raw_value === 'blocked'"
                                  class="o_bhd_status_badge o_bhd_badge_blocked">Blocked</span>
                            <span t-elif="record.x_kanban_status.raw_value === 'waiting'"
                                  class="o_bhd_status_badge o_bhd_badge_waiting">Waiting</span>

                            <!-- Cups by AA badge + cup size in hero -->
                            <div t-if="record.is_cupsbyaa.raw_value"
                                 class="o_bhd_cupsbyaa_hero_badge">
                                <span>&#9749;</span>
                                <span t-if="record.cupsbyaa_cup_size.raw_value">
                                    <t t-out="record.cupsbyaa_cup_size.raw_value"/>
                                </span>
                                <span t-else="">CbAA</span>
                            </div>

                            <!-- Turnaround badge for rush orders -->
                            <div t-if="record.is_cupsbyaa.raw_value &amp;&amp; record.cupsbyaa_turnaround.raw_value &amp;&amp; record.cupsbyaa_turnaround.raw_value !== 'normal'"
                                 t-attf-class="o_bhd_turnaround_badge o_bhd_turnaround_#{record.cupsbyaa_turnaround.raw_value}">
                                <t t-if="record.cupsbyaa_turnaround.raw_value === 'super'">SUPER RUSH</t>
                                <t t-elif="record.cupsbyaa_turnaround.raw_value === 'urgent'">URGENT</t>
                                <t t-elif="record.cupsbyaa_turnaround.raw_value === 'expedited'">EXPEDITED</t>
                            </div>

                            <!-- Priority widget -->
                            <div class="o_bhd_priority_overlay">
                                <field name="priority" widget="priority"/>
                            </div>
                        </div>

                        <!-- Card body -->
                        <div t-attf-class="o_bhd_body #{record.is_cupsbyaa.raw_value ? 'o_bhd_body_cupsbyaa' : ''} #{record.x_kanban_status.raw_value === 'blocked' ? 'o_bhd_body_blocked' : record.x_kanban_status.raw_value === 'waiting' ? 'o_bhd_body_waiting' : ''} #{record.is_overdue.raw_value ? 'o_bhd_body_overdue' : record.x_deadline_status.raw_value === 'today' ? 'o_bhd_body_today' : ''}">

                            <!-- MO number + stage badge -->
                            <div class="o_bhd_top_row">
                                <span class="o_bhd_mo_ref"><field name="name"/></span>
                                <span t-attf-class="o_bhd_stage_badge o_bhd_stage_#{record.x_simple_stage.raw_value}">
                                    <t t-out="record.x_simple_stage.value"/>
                                </span>
                            </div>

                            <!-- Product name + qty -->
                            <div class="o_bhd_product_row">
                                <div class="o_bhd_product_name fw-bold"><field name="x_product_short_name"/></div>
                                <div class="o_bhd_qty_badge">x<field name="product_qty"/></div>
                            </div>

                            <!-- Customer + SO -->
                            <div t-if="record.x_partner_id.raw_value" class="o_bhd_info_row">
                                <i class="fa fa-user-o me-1"/><field name="x_partner_id"/>
                            </div>

                            <!-- Customer phone (cupsbyaa or regular) -->
                            <div t-if="record.x_partner_phone.raw_value" class="o_bhd_info_row o_bhd_phone_row">
                                <i class="fa fa-phone me-1"/><t t-out="record.x_partner_phone.raw_value"/>
                            </div>

                            <div t-if="record.origin.raw_value" class="o_bhd_info_row o_bhd_origin_row">
                                <i class="fa fa-file-text-o me-1"/><field name="origin"/>
                            </div>

                            <!-- Cups by AA website order indicator with cup size -->
                            <div t-if="record.is_cupsbyaa.raw_value" class="o_bhd_info_row">
                                <span class="o_bhd_cupsbyaa_badge">
                                    &#9749; #<t t-out="record.cupsbyaa_order_id.raw_value"/>
                                    <t t-if="record.cupsbyaa_cup_size.raw_value">
                                        | <t t-out="record.cupsbyaa_cup_size.raw_value"/>
                                    </t>
                                </span>
                            </div>

                            <!-- Delivery Status -->
                            <div t-if="record.x_delivery_ref.raw_value"
                                 t-attf-class="o_bhd_delivery #{record.x_delivery_state.raw_value == 'done' ? 'o_bhd_delivery_done' : record.x_delivery_state.raw_value == 'cancel' ? 'o_bhd_delivery_cancel' : 'o_bhd_delivery_pending'}">
                                <i t-attf-class="fa #{record.x_delivery_state.raw_value == 'done' ? 'fa-check-circle' : record.x_delivery_state.raw_value == 'cancel' ? 'fa-times-circle' : 'fa-truck'}"/>
                                <span class="o_bhd_delivery_ref"><t t-out="record.x_delivery_ref.raw_value"/></span>
                                <span class="o_bhd_delivery_badge ms-1">
                                    <t t-if="record.x_delivery_state.raw_value == 'done'">Done</t>
                                    <t t-elif="record.x_delivery_state.raw_value == 'cancel'">Cancelled</t>
                                    <t t-elif="record.x_delivery_state.raw_value == 'assigned'">Ready</t>
                                    <t t-elif="record.x_delivery_state.raw_value == 'waiting'">Waiting</t>
                                    <t t-elif="record.x_delivery_state.raw_value == 'confirmed'">Confirmed</t>
                                    <t t-else=""><t t-out="record.x_delivery_state.raw_value"/></t>
                                </span>
                            </div>

                            <!-- Deadline with days remaining - PROMINENT for cupsbyaa -->
                            <div t-if="record.date_deadline.raw_value"
                                 t-attf-class="o_bhd_deadline #{record.is_cupsbyaa.raw_value ? 'o_bhd_deadline_cupsbyaa' : ''} o_bhd_deadline_#{record.x_deadline_status.raw_value}">
                                <i t-attf-class="fa #{record.is_overdue.raw_value ? 'fa-exclamation-triangle' : record.x_deadline_status.raw_value === 'today' ? 'fa-clock-o' : 'fa-calendar'} me-1"/>
                                <field name="date_deadline"/>
                                <span t-if="record.x_deadline_days.raw_value > 1" class="o_bhd_days_label text-success ms-1">
                                    (<t t-out="record.x_deadline_days.raw_value"/>d)
                                </span>
                                <span t-elif="record.x_deadline_days.raw_value === 1" class="o_bhd_days_label text-warning ms-1">
                                    (tomorrow!)
                                </span>
                                <span t-elif="record.x_deadline_days.raw_value === 0" class="o_bhd_days_label text-warning ms-1">
                                    (today!)
                                </span>
                                <span t-elif="record.x_deadline_days.raw_value &lt; 0" class="o_bhd_days_label text-danger ms-1">
                                    (<t t-out="-record.x_deadline_days.raw_value"/>d overdue)
                                </span>
                            </div>

                            <!-- Assigned worker -->
                            <div t-if="record.assigned_to.raw_value" class="o_bhd_info_row">
                                <i class="fa fa-wrench me-1"/><field name="assigned_to"/>
                            </div>

                            <!-- Notes preview -->
                            <div t-if="record.x_notes.raw_value" class="o_bhd_notes">
                                <i class="fa fa-sticky-note-o me-1"/>
                                <span class="o_bhd_notes_preview">
                                    <t t-if="record.x_notes.raw_value.length > 50">
                                        <t t-out="record.x_notes.raw_value.substring(0, 50)"/>...
                                    </t>
                                    <t t-else="">
                                        <t t-out="record.x_notes.raw_value"/>
                                    </t>
                                </span>
                            </div>

                            <!-- Invoice photos -->
                            <div t-if="record.x_invoice_image_count.raw_value > 0" class="o_bhd_photos_row">
                                <i class="fa fa-camera me-1"/>
                                <t t-out="record.x_invoice_image_count.raw_value"/> photo(s)
                            </div>

                            <!-- Action buttons -->
                            <div class="o_bhd_actions">
                                <button t-if="record.x_simple_stage.raw_value == 'design'"
                                        name="action_next_stage" type="object"
                                        class="btn btn-sm btn-primary o_bhd_btn_next">
                                    <i class="fa fa-print"/> Print
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'printing'"
                                        name="action_next_stage" type="object"
                                        class="btn btn-sm btn-info o_bhd_btn_next text-white">
                                    <i class="fa fa-paint-brush"/> Finish
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'finishing'"
                                        name="action_next_stage" type="object"
                                        class="btn btn-sm btn-warning o_bhd_btn_next">
                                    <i class="fa fa-archive"/> Pack
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'packing'"
                                        name="action_next_stage" type="object"
                                        class="btn btn-sm btn-warning o_bhd_btn_next">
                                    <i class="fa fa-search"/> QC
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'qc'"
                                        name="action_next_stage" type="object"
                                        class="btn btn-sm btn-success o_bhd_btn_next">
                                    <i class="fa fa-check-circle"/> Approve
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'done'"
                                        name="action_deliver" type="object"
                                        class="btn btn-sm btn-primary o_bhd_btn_next">
                                    <i class="fa fa-truck"/> Deliver
                                </button>
                                <button t-if="record.x_delivery_ref.raw_value &amp;&amp; record.x_delivery_state.raw_value != 'done' &amp;&amp; record.x_delivery_state.raw_value != 'cancel' &amp;&amp; record.x_simple_stage.raw_value != 'done'"
                                        name="action_validate_delivery" type="object"
                                        class="btn btn-sm btn-danger o_bhd_btn_deliver"
                                        title="Validate Delivery">
                                    <i class="fa fa-check-circle"/> Validate
                                </button>
                                <button t-if="record.x_simple_stage.raw_value == 'on_hold'"
                                        name="action_resume" type="object"
                                        class="btn btn-sm btn-info o_bhd_btn_next text-white">
                                    <i class="fa fa-play"/> Resume
                                </button>
                                <button t-if="!['design','done','delivery_done','on_hold'].includes(record.x_simple_stage.raw_value)"
                                        name="action_hold" type="object"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Hold">
                                    <i class="fa fa-pause"/>
                                </button>

                                <button t-if="record.x_kanban_status.raw_value != 'blocked'"
                                        name="action_toggle_blocked" type="object"
                                        class="btn btn-sm btn-outline-warning o_bhd_btn_block"
                                        title="Mark as Blocked">
                                    &#128683;
                                </button>
                                <button t-if="record.x_kanban_status.raw_value == 'blocked'"
                                        name="action_toggle_blocked" type="object"
                                        class="btn btn-sm btn-warning o_bhd_btn_block"
                                        title="Unblock">
                                    &#9989;
                                </button>

                                <button name="action_open_notes" type="object"
                                        class="btn btn-sm btn-outline-secondary o_bhd_btn_notes"
                                        title="Add/Edit Notes">
                                    &#128221;
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- SEARCH VIEW v6.0                             -->
    <!-- ============================================ -->

    <record id="view_mrp_production_filter_enhanced" model="ir.ui.view">
        <field name="name">mrp.production.filter.enhanced</field>
        <field name="model">mrp.production</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <search string="Search Manufacturing Orders">
                <field name="name" string="MO / SO Reference"
                    filter_domain="['|', ('name', 'ilike', self), ('origin', 'ilike', self)]"/>
                <field name="product_id"/>
                <field name="x_partner_id" string="Customer"/>
                <field name="assigned_to" string="Worker"/>
                <field name="x_product_categ_id" string="Product Category"/>
                <field name="cupsbyaa_order_id" string="CbAA Order #"/>

                <filter name="filter_active" string="Active"
                    domain="[('x_simple_stage', 'not in', ['done', 'delivery_done']), ('state', '!=', 'cancel')]"/>
                <filter name="filter_done" string="Done"
                    domain="[('x_simple_stage', '=', 'done')]"/>

                <separator/>

                <filter name="filter_blocked" string="Blocked"
                    domain="[('x_kanban_status', '=', 'blocked')]"/>
                <filter name="filter_waiting" string="Waiting"
                    domain="[('x_kanban_status', '=', 'waiting')]"/>
                <filter name="filter_normal" string="Normal"
                    domain="[('x_kanban_status', '=', 'normal')]"/>

                <separator/>

                <filter name="filter_overdue" string="Overdue"
                    domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_due_today" string="Due Today"
                    domain="[('x_deadline_status', '=', 'today')]"/>
                <filter name="filter_due_soon" string="Due Soon"
                    domain="[('x_deadline_status', '=', 'warning')]"/>

                <separator/>

                <filter name="filter_design" string="Design"
                    domain="[('x_simple_stage', '=', 'design')]"/>
                <filter name="filter_printing" string="Printing"
                    domain="[('x_simple_stage', '=', 'printing')]"/>
                <filter name="filter_finishing" string="Finishing"
                    domain="[('x_simple_stage', '=', 'finishing')]"/>
                <filter name="filter_on_hold" string="On Hold"
                    domain="[('x_simple_stage', '=', 'on_hold')]"/>
                <filter name="filter_packing" string="Packing"
                    domain="[('x_simple_stage', '=', 'packing')]"/>

                <separator/>

                <filter name="filter_cupsbyaa" string="Cups by AA"
                    domain="[('is_cupsbyaa', '=', True)]"/>

                <separator/>

                <filter name="filter_high_priority" string="High Priority"
                    domain="[('priority', 'in', ['2', '3'])]"/>
                <filter name="filter_unassigned" string="Unassigned"
                    domain="[('assigned_to', '=', False)]"/>

                <separator/>

                <filter name="group_by_stage" string="Stage"
                    context="{'group_by': 'x_simple_stage'}"/>
                <filter name="group_by_status" string="Status"
                    context="{'group_by': 'x_kanban_status'}"/>
                <filter name="group_by_product" string="Product"
                    context="{'group_by': 'product_id'}"/>
                <filter name="group_by_customer" string="Customer"
                    context="{'group_by': 'x_partner_id'}"/>
                <filter name="group_by_category" string="Category"
                    context="{'group_by': 'x_product_categ_id'}"/>
                <filter name="group_by_priority" string="Priority"
                    context="{'group_by': 'priority'}"/>
                <filter name="group_by_assigned" string="Assigned To"
                    context="{'group_by': 'assigned_to'}"/>
                <filter name="group_by_deadline" string="Deadline"
                    context="{'group_by': 'date_deadline'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- LIST VIEW v6.0                               -->
    <!-- ============================================ -->

    <record id="view_mrp_production_list_enhanced" model="ir.ui.view">
        <field name="name">mrp.production.list.enhanced</field>
        <field name="model">mrp.production</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue == True"
                   decoration-warning="x_deadline_status in ('warning', 'today')"
                   decoration-muted="x_simple_stage == 'done'"
                   multi_edit="1">
                <field name="name"/>
                <field name="x_product_short_name" string="Product"/>
                <field name="product_qty"/>
                <field name="x_partner_id" string="Customer"/>
                <field name="x_partner_phone" string="Phone" optional="show"/>
                <field name="x_product_categ_id" string="Category"/>
                <field name="origin" string="SO Ref"/>
                <field name="x_simple_stage" string="Stage" widget="badge"/>
                <field name="x_kanban_status" string="Status" widget="badge"
                       decoration-danger="x_kanban_status == 'blocked'"
                       decoration-warning="x_kanban_status == 'waiting'"
                       decoration-success="x_kanban_status == 'normal'"/>
                <field name="date_deadline"/>
                <field name="x_deadline_days" string="Days Left"/>
                <field name="priority" widget="priority"/>
                <field name="assigned_to"/>
                <field name="is_cupsbyaa" string="CbAA" widget="boolean_toggle"/>
                <field name="cupsbyaa_order_id" string="CbAA Order" optional="show"/>
                <field name="cupsbyaa_cup_size" string="Cup Size" optional="show"/>
