<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Daily deadline status refresh -->
    <record id="ir_cron_refresh_deadline_status" model="ir.cron">
        <field name="name">MO Kanban: Refresh Deadline Status</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_deadline_status()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Legacy cron (disabled) -->
    <record id="ir_cron_check_overdue_mos" model="ir.cron">
        <field name="name">MO Kanban: Check Overdue Orders (Legacy)</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model.search([("is_overdue", "=", True), ("x_simple_stage", "!=", "done")])</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
