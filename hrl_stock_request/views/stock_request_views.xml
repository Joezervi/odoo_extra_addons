<?xml version="1.0"?>
<odoo>
    <record id="view_hrl_stock_request_tree" model="ir.ui.view">
        <field name="name">hrl.stock.request.list</field>
        <field name="model">hrl.stock.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" decoration-bf="1"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" string="From" optional="show"/>
                <field name="location_dest_id" string="To" optional="show"/>
                <field name="request_uid" optional="hide"/>
                <field name="request_date" optional="hide"/>
                <field name="scheduled_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="notes" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hrl_stock_request_form" model="ir.ui.view">
        <field name="name">hrl.stock.request.form</field>
        <field name="model">hrl.stock.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_confirm" invisible="state != 'draft'" type="object" class="oe_highlight oe_inline" confirm="Are you sure to confirm this Stock Request ?" string="Confirm"/>
                    <button name="button_validate" invisible="state != 'confirm'" type="object" class="oe_highlight oe_inline" groups="stock.group_stock_manager" confirm="Are you sure to validate this Stock Request ?" string="Validate"/>
                    <button name="button_cancel" invisible="state not in ['draft', 'confirm']" type="object" confirm="Are you sure to cancel this Stock Request ?" string="Cancel"/>
                    <button name="button_draft" invisible="state != 'cancel'" type="object" groups="stock.group_stock_manager" string="Set Draft"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_outgoing" class="oe_stat_button" icon="fa-truck">
                            <field name="outgoing_count" widget="statinfo" string="Delivery"/>
                        </button>
                        <button type="object" name="action_view_incoming" class="oe_stat_button" icon="fa-truck">
                            <field name="incoming_count" widget="statinfo" string="Receipt"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Request Number</span>
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="3" colspan="3">
                        <group string="Info">
                            <field name="company_id" invisible="1"/>
                            <field name="request_uid" force_save="1"/>
                            <field name="request_date" force_save="1"/>
                            <field name="scheduled_date" readonly="state != 'draft'"/>
                            <field name="notes" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" force_save="1"/>
                        </group>
                        <group string="Source">
                            <field name="warehouse_id" options="{'no_create': True}" domain="[('company_id','=', company_id)]" readonly="state != 'draft'"/>
                            <field name="location_id" options="{'no_create': True}" domain="[('usage','=', 'internal'),('warehouse_id','=', warehouse_id)]" readonly="state != 'draft'" string="Location"/>
                            <field name="picking_type_id" options="{'no_create': True}" domain="[('code','=', 'internal'),('warehouse_id','=', warehouse_id)]" readonly="state != 'draft'" string="Operation Type"/>
                        </group>
                        <group string="Destination">
                            <field name="location_dest_id" domain="[('usage','=', 'internal')]" options="{'no_create': True}" readonly="state != 'draft'" string="Location"/>
                            <field name="warehouse_dest_id" invisible="1"/>
                            <field name="picking_type_dest_id" options="{'no_create': True}" domain="[('code','=', 'internal'),('warehouse_id','=', warehouse_dest_id)]" readonly="state != 'draft'" string="Operation Type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request List">
                            <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}" context="{'default_detailed_type': 'product'}" domain="[('type','in', ['product','consu']),'|',('company_id','=', False),('company_id','=', parent.company_id)]"/>
                                    <field name="name"/>
                                    <field name="product_uom_id" options="{'no_create': True}"/>
                                    <field name="product_qty"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="product_id"/>
                                                <field name="name"/>
                                                <label for="product_qty"/>
                                                <div class="o_row">
                                                    <field name="product_qty"/>
                                                    <span class="oe_inline"></span>
                                                    <field name="product_uom_id"/>
                                                </div>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hrl_stock_request_search" model="ir.ui.view">
        <field name="name">hrl.stock.request.search</field>
        <field name="model">hrl.stock.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Request Number" filter_domain="[('name', 'ilike', self)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirm" domain="[('state', '=', 'confirm')]"/>
                <filter string="Validated" name="filter_validate" domain="[('state', '=', 'validate')]"/>
                <filter string="Canceled" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="my_request" string="My Requests" domain="[('request_uid', '=', uid)]"/>
                <group>
                    <filter string="Warehouse" name="group_by_warehouse_id" domain="[]" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Request Date" name="group_by_request_date" domain="[]" context="{'group_by': 'request_date'}"/>
                    <filter string="Scheduled Date" name="group_by_scheduled_date" domain="[]" context="{'group_by': 'scheduled_date'}"/>
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hrl_stock_request" model="ir.actions.act_window">
        <field name="name">Stock Request</field>
        <field name="res_model">hrl.stock.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_my_request': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click create to add data ...
            </p>
        </field>
    </record>
    <menuitem id="menu_hrl_stock_request" name="Stock Request" parent="stock.menu_stock_transfers" action="action_hrl_stock_request" sequence="40"/>
</odoo>