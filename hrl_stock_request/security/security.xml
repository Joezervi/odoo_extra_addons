<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="hrl_stock_request_company_rule" model="ir.rule">
            <field name="name">Stock Request: multi-company</field>
            <field name="model_id" ref="model_hrl_stock_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="hrl_stock_request_line_company_rule" model="ir.rule">
            <field name="name">Stock Request Line: multi-company</field>
            <field name="model_id" ref="model_hrl_stock_request_line"/>
            <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>